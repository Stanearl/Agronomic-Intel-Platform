# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
# NOTE: This project intentionally COMMITS its production .env files
# (root .env, backend/.env, frontend/.env) so that a fresh `git clone` on
# the Hetzner server already has working configuration with no manual
# setup step. They contain no secrets (no API keys/passwords) — only
# public domain names and non-sensitive tuning values. Local override
# files are still ignored below.
.env.local
.env.*.local

# caddy.env holds a real Cloudflare API token (DNS edit scope) — a genuine
# secret — and must NEVER be committed. Copy caddy.env.example -> caddy.env
# on the server and fill in the real token there.
caddy.env

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Soil health PMTiles pipeline (backend/scripts/generate_soil_grid.py)
# ---------------------------------------------------------------------
# soil_health_grid.geojson is a large (~20MB), fully reproducible
# intermediate artifact — regenerate it any time with:
#   python backend/scripts/generate_soil_grid.py
# The final backend/data/tiles/*.pmtiles archive IS committed (it's
# the actual artifact FastAPI serves to the frontend, and per-commit
# regeneration via tippecanoe requires a separate toolchain — see
# DEPLOY.md and generate_soil_grid.py's docstring).
backend/data/soil_health_grid.geojson

# backend/data/true_boundary.geojson IS committed (it's a small,
# static, pre-defined artifact the live API loads on startup for
# out-of-bounds validation — see app/boundary.py).
backend/cache/
