VITE_API_BASE_URL=http://localhost:8087
VITE_PROXY_TARGET=http://localhost:8087

# Zero-cost MapLibre GL JS basemap style (OpenFreeMap Positron).
# No API key required — safe for unlimited scale deployments.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Continuous soil-health interpolation overlay (PMTiles archive built by
# backend/scripts/generate_soil_grid.py + tippecanoe, served statically
# by FastAPI with HTTP Range Request support — see backend/app/main.py).
# Defaults to `${VITE_API_BASE_URL}/tiles/soil-health.pmtiles` when unset.
VITE_SOIL_HEALTH_PMTILES_URL=http://localhost:8087/tiles/soil-health.pmtiles
