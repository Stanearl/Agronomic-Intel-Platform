# ==============================================================================
# Agronomic Intel Platform — Frontend (Vite/React) PRODUCTION environment
# Hetzner Cloud deployment — server 167.235.193.135
# ==============================================================================
# IMPORTANT — Vite bakes VITE_* variables into the static JS bundle at BUILD
# TIME, not at container runtime. Simply placing this file on the server has
# NO effect on an already-built Docker image. It is used when:
#   1. Running `npm run build` / `npm run preview` directly on the server, OR
#   2. As the source of truth mirrored into the *root* .env file consumed by
#      docker-compose.yml's `build.args` for the frontend service.
# See DEPLOY.md for the full production deployment procedure.
# ==============================================================================

# Public HTTPS URL of the FastAPI backend (Caddy-fronted, see Caddyfile).
VITE_API_BASE_URL=https://dfdst-api.ris.africa

# Only relevant for local `npm run dev` — proxies /api requests. Unused in
# the production Docker/nginx build.
VITE_PROXY_TARGET=https://dfdst-api.ris.africa

# Zero-cost MapLibre GL JS basemap style (OpenFreeMap Positron).
# No API key required — safe for unlimited scale deployments.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Continuous soil-health interpolation overlay — pre-computed PMTiles
# archive served statically by the FastAPI backend (see DEPLOY.md and
# backend/scripts/generate_soil_grid.py for how it's generated).
VITE_SOIL_HEALTH_PMTILES_URL=https://dfdst-api.ris.africa/tiles/soil-health.pmtiles
