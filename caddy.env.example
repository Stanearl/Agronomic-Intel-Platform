# Copy to caddy.env on the server and fill in a real Cloudflare API token.
# DO NOT commit caddy.env to git — it contains a real secret.
#
# Generate the token at:
#   Cloudflare Dashboard > My Profile > API Tokens > Create Token
#   Use the "Edit zone DNS" template, scoped to the ris.africa zone only.
#
# This token is used by Caddy for the DNS-01 ACME challenge (see Caddyfile),
# which lets Caddy obtain valid Let's Encrypt certificates for
# dfdst.ris.africa / api.dfdst.ris.africa WITHOUT needing port 80 reachable
# — required here since ports 80/443 on this host are already used by
# another site's reverse proxy.
CLOUDFLARE_API_TOKEN=your-cloudflare-dns-edit-token-here
