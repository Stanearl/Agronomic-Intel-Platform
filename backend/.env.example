# Copy to backend/.env and adjust for your environment.
# See backend/app/config.py for the full list of consumed settings.

ENVIRONMENT=production
CSV_PATH=/app/data/kisumu_pilot_soils.csv

# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=https://dfdst.ris.africa

RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

MAX_PAYLOAD_BYTES=16384

# Comma-separated list of Host headers this API will answer to.
TRUSTED_HOSTS=api.dfdst.ris.africa,localhost,127.0.0.1
