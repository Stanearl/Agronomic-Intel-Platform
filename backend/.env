# ==============================================================================
# Agronomic Intel Platform — Backend (FastAPI) PRODUCTION environment variables
# Hetzner Cloud deployment — server 167.235.193.135
# Consumed by backend/app/config.py (pydantic-settings BaseSettings) at
# process startup. When running via Docker Compose these are injected into
# the container environment through the `env_file:` directive — the file
# itself never needs to be baked into the image.
# ==============================================================================

# Runtime environment. "production" disables the interactive Swagger UI
# (/docs) and ReDoc (/redoc) endpoints — see app/main.py.
ENVIRONMENT=production

# Absolute path to the pilot soils CSV *inside the container*. This matches
# the default already baked into backend/Dockerfile (ENV CSV_PATH=...), so
# it only needs to be overridden if you mount a different dataset.
CSV_PATH=/app/data/kisumu_pilot_soils.csv

# Directory *inside the container* holding pre-computed PMTiles archives
# (e.g. soil-health.pmtiles), served statically with HTTP Range Request
# support at the /tiles URL prefix — see app/main.py. Regenerate the
# underlying GeoJSON with backend/scripts/generate_soil_grid.py, then
# build/refresh the archive with tippecanoe (see that script's docstring
# and DEPLOY.md for the exact commands).
TILES_DIR=/app/data/tiles

# Absolute path *inside the container* to the static, pre-defined
# boundary GeoJSON (backend/data/true_boundary.geojson — a hardcoded
# shape, no dynamic OSM queries or buffering). Loaded on startup and
# used by /api/v1/soil-score to reject dropped pins/GPS fixes that
# fall outside this specific shape instead of returning a fabricated
# soil score.
COVERAGE_BOUNDARY_PATH=/app/data/true_boundary.geojson

# ------------------------------------------------------------------------------
# CORS — comma-separated list of origins allowed to call this API.
# Must be the exact scheme + host (+ port if non-standard) of the deployed
# frontend. No trailing slash.
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://dfdst.ris.africa

# ------------------------------------------------------------------------------
# Rate limiting — in-memory sliding window, keyed by client IP
# (X-Forwarded-For aware — see app/main.py::_client_ip). Tune as needed.
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Maximum accepted request body size, in bytes (16 KB). This API is read-only
# (GET/OPTIONS) so this is a defensive ceiling, not a functional requirement.
MAX_PAYLOAD_BYTES=16384

# TrustedHostMiddleware — comma-separated list of Host headers this API will
# answer to. Must include the public API domain. localhost/127.0.0.1 are kept
# so the container's own HEALTHCHECK (curl to 127.0.0.1:8087/health) keeps
# working from inside the container.
TRUSTED_HOSTS=dfdst-api.ris.africa,localhost,127.0.0.1
