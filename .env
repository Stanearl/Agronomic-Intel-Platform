# ==============================================================================
# Root environment file — consumed by docker-compose.yml ONLY.
# This is NOT read by the frontend or backend applications directly; it
# supplies build-args to the frontend image and domain/email values to the
# Caddy reverse proxy. Keep this file OUT of git (see .gitignore).
# ==============================================================================

# --- Public domains (must have DNS A records pointing at 167.235.193.135) ---
FRONTEND_DOMAIN=dfdst.ris.africa
BACKEND_DOMAIN=dfdst-api.ris.africa

# --- Email used by Caddy for Let's Encrypt certificate registration/renewal ---
ACME_EMAIL=admin@ris.africa


# --- Baked into the frontend static build at image build time (Vite) ---
VITE_API_BASE_URL=https://dfdst-api.ris.africa
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron


